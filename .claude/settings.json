{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push -f*)",
      "Bash(git push --force*)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "Bash(git merge *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "node .claude/hooks/block-protected-branch.cjs" }]
      }
    ]
  }
}
